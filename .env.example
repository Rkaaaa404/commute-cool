# ============================================================
# COMMUTE-COOL Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Database ---
DATABASE_URL=postgresql://cc_user:cc_dev_pass@localhost:5432/commute_cool
ASYNC_DATABASE_URL=postgresql+asyncpg://cc_user:cc_dev_pass@localhost:5432/commute_cool

# --- Data Lake ---
RAW_DATA_DIR=./data/raw

# --- API Keys (register to get these, all free tier) ---
# WAQI: https://aqicn.org/data-platform/token/
WAQI_API_TOKEN=

# TomTom: https://developer.tomtom.com/
TOMTOM_API_KEY=

# --- Spark (used inside Docker container, no need to change) ---
SPARK_MASTER_URL=local[*]

# --- API (FastAPI) ---
# Comma-separated allowed CORS origins ("*" = allow all, fine for local dev)
CORS_ORIGINS=*
# Token for /api/debug/* and /api/admin/* (send as X-Admin-Token header).
# Leave empty to disable those endpoints (they return 404).
ADMIN_TOKEN=
# asyncpg pool. On AWS Lambda + Supabase transaction pooler: 0 / 3 / 0
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_STATEMENT_CACHE_SIZE=100

# --- Deployment: snapshot sync (scripts/sync_to_supabase.sh) ---
# Supabase *session* pooler URL (port 5432)
SUPABASE_DB_URL=
