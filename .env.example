# ============================================================
# COMMUTE-COOL Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Database ---
DATABASE_URL=postgresql://cc_user:cc_dev_pass@localhost:5432/commute_cool
SYNC_DATABASE_URL=postgresql://cc_user:cc_dev_pass@localhost:5432/commute_cool
ASYNC_DATABASE_URL=postgresql+asyncpg://cc_user:cc_dev_pass@localhost:5432/commute_cool

# --- Data Lake ---
RAW_DATA_DIR=./data/raw

# --- API Keys (register to get these) ---
# WAQI: https://aqicn.org/data-platform/token/
WAQI_API_TOKEN=

# TomTom: https://developer.tomtom.com/
TOMTOM_API_KEY=

# Google Earth Engine: https://earthengine.google.com/signup/
# (uses service account JSON or authenticated session)
GEE_SERVICE_ACCOUNT=
GEE_KEY_FILE=

# --- Spark ---
SPARK_MASTER_URL=spark://localhost:7077

# --- GraphHopper ---
GRAPHHOPPER_URL=http://localhost:8989
